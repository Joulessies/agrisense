// ============================================================
//  AgriSense — device secrets
//  1. Copy this file to agrisense_secrets.h  (same folder)
//  2. Fill in every value below
//  3. agrisense_secrets.h is git-ignored — never commit real keys
// ============================================================

// --- Supabase (PostgREST) -----------------------------------
// Project ref: Settings → API → Project URL
//   e.g. "abcdefghijklmnop.supabase.co"   (no https://)
#define SUPABASE_HOST     "YOUR_PROJECT_REF.supabase.co"

// anon / public key: Settings → API → Project API keys
#define SUPABASE_ANON_KEY "YOUR_SUPABASE_ANON_KEY"

// --- Device identity ----------------------------------------
// Unique ID for this node — shows up in the Sensors view
#define DEVICE_ID         "agrisense-001"

// --- WiFi ---------------------------------------------------
#define WIFI_SSID         "YOUR_WIFI_SSID"
#define WIFI_PASS         "YOUR_WIFI_PASSWORD"
